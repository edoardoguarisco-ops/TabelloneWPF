<Window x:Class="TabelloneWPF.InfoPartitaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Info partita" Height="620" Width="980"
        Background="#0F0A14" WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="INFORMAZIONI PARTITA" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Column="0" Header="Squadra 1" Foreground="#007ACC" FontWeight="Bold" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtNomeSquadra1" IsReadOnly="True" Height="30" Background="#1D1226" Foreground="White" Padding="5" VerticalContentAlignment="Center"/>
                    <Image x:Name="ImgLogoSquadra1" Grid.Column="1" Width="75" Height="75" Stretch="Uniform" Margin="10,0,0,0"/>
                </Grid>
            </GroupBox>
            <GroupBox Grid.Column="2" Header="Squadra 2" Foreground="#D97706" FontWeight="Bold" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtNomeSquadra2" IsReadOnly="True" Height="30" Background="#1D1226" Foreground="White" Padding="5" VerticalContentAlignment="Center"/>
                    <Image x:Name="ImgLogoSquadra2" Grid.Column="1" Width="75" Height="75" Stretch="Uniform" Margin="10,0,0,0"/>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="1" Grid.ColumnSpan="3" Header="Data e ora inizio partita" Foreground="#A855F7" FontWeight="Bold" Padding="10" Margin="0,12,0,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Data:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker x:Name="PickerDataPartita" Width="150"/>
                    <TextBlock Text="Ora:" Foreground="White" VerticalAlignment="Center" Margin="25,0,8,0"/>
                    <TextBox x:Name="TxtOraInizio" Width="90" Height="28" Text="20:30" Padding="5"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="2" Grid.ColumnSpan="3" Header="Ufficiali di gara e referto" Foreground="#A855F7" FontWeight="Bold" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Vis." Foreground="#888" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="Ruolo" Foreground="#888" FontWeight="Bold"/>
                        <TextBlock Grid.Column="2" Text="Cognome" Foreground="#888" FontWeight="Bold"/>
                        <TextBlock Grid.Column="3" Text="Nome" Foreground="#888" FontWeight="Bold"/>
                    </Grid>
                    <ItemsControl x:Name="ItemsUfficiali" Grid.Row="1">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Visualizza, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding Ruolo}" IsReadOnly="True" Background="#1D1226" Foreground="#A855F7" FontWeight="Bold" Margin="3,0" Padding="4"/>
                                    <TextBox Grid.Column="2" Text="{Binding Cognome, UpdateSourceTrigger=PropertyChanged}" Background="#1D1226" Foreground="White" Margin="3,0" Padding="4"/>
                                    <TextBox Grid.Column="3" Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" Background="#1D1226" Foreground="White" Margin="3,0" Padding="4"/>
                                    <Button Grid.Column="4" Content="📷" Width="28" Height="25" Click="BtnCaricaFotoUfficiale_Click" Loaded="BtnFotoUfficiale_Loaded" Background="#2A1B3D" Foreground="Gray" ToolTip="Seleziona foto"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Annulla" Width="100" Height="32" Margin="0,0,8,0" Click="BtnAnnulla_Click"/>
            <Button Content="Salva" Width="100" Height="32" Background="#4A2E6B" Foreground="White" Click="BtnSalva_Click"/>
        </StackPanel>
    </Grid>
</Window>

    