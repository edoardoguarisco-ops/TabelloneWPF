<Window x:Class="TabelloneWPF.ConsoleControllo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Console di Controllo" Height="420" Width="800"
        Background="#120D1A" WindowStartupLocation="Manual"
        SizeToContent="Height">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Intestazione -->
        <TextBlock Text="CONSOLE CONTROLLO" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- Area Centrale -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">

            <!-- SQUADRA 1 e 2 AFFIANCATE CON PULSANTI A DUE RIGHE -->
            <UniformGrid Columns="2" Margin="0,0,0,10">
                <!-- SQUADRA 1 -->
                <GroupBox Header="Squadra 1" Foreground="#007ACC" FontWeight="Bold" FontSize="14" Margin="0,0,5,0" Padding="10">
                    <StackPanel>
                        <Button x:Name="BtnPunto1" Click="BtnPunto1_Click" Height="70" Background="#007ACC" Foreground="White" FontWeight="Bold" Margin="0,0,0,6">
                            <TextBlock TextAlignment="Center">
                        <Run Text="+1" FontSize="22"/><LineBreak/>
                        <Run x:Name="TxtNomeBtn1" Text="SQUADRA 1" FontSize="12"/>
                            </TextBlock>
                        </Button>
                        <Button Content="-1 Punto" Click="BtnAnnulla1_Click" Height="28" Background="#333" Foreground="White" FontSize="12"/>
                    </StackPanel>
                </GroupBox>

                <!-- SQUADRA 2 -->
                <GroupBox Header="Squadra 2" Foreground="#D97706" FontWeight="Bold" FontSize="14" Margin="5,0,0,0" Padding="10">
                    <StackPanel>
                        <Button x:Name="BtnPunto2" Click="BtnPunto2_Click" Height="70" Background="#D97706" Foreground="White" FontWeight="Bold" Margin="0,0,0,6">
                            <TextBlock TextAlignment="Center">
                        <Run Text="+1" FontSize="22"/><LineBreak/>
                        <Run x:Name="TxtNomeBtn2" Text="SQUADRA 2" FontSize="12"/>
                            </TextBlock>
                        </Button>
                        <Button Content="-1 Punto" Click="BtnAnnulla2_Click" Height="28" Background="#333" Foreground="White" FontSize="12"/>
                    </StackPanel>
                </GroupBox>
            </UniformGrid>

            <!-- PANNELLO PULSANTI ANIMAZIONI / EFFETTI (Visibile solo se attivo da Opzioni) -->
            <StackPanel x:Name="PanelAnimazioni" Visibility="Collapsed" Margin="0,0,0,10">
                <!-- CORRETTO -->
                <Border Background="#1D1226" BorderBrush="#A855F7" BorderThickness="1" CornerRadius="4" Padding="8">
                    <UniformGrid Columns="7">
                        <Button x:Name="BtnSponsor" Content="Sponsor" Click="BtnSponsor_Click" Height="30" Background="#332244" Foreground="White" FontSize="11" Margin="1"/>
                        <Button x:Name="BtnRose" Content="Rose" Click="BtnRose_Click" Height="30" Background="#332244" Foreground="White" FontSize="11" Margin="1"/>
                        <Button x:Name="BtnPresentazionePartita" Content="Presentazione" Click="BtnPresentazionePartita_Click" Height="30" Background="#332244" Foreground="White" FontSize="10" Margin="1"/>
                        <Button Content="Starting Six" Height="30" Background="#332244" Foreground="White" FontSize="10" Margin="1"/>
                        <Button Content="Ace" Height="30" Background="#332244" Foreground="White" FontSize="11" Margin="1"/>
                        <Button Content="Muro" Height="30" Background="#332244" Foreground="White" FontSize="11" Margin="1"/>
                        <Button Content="Attacco" Height="30" Background="#332244" Foreground="White" FontSize="11" Margin="1"/>
                    </UniformGrid>
                </Border>
            </StackPanel>

            <!-- MENU AVANZATO -->
            <Expander Header="⚙️ Funzioni avanzate" Foreground="#A855F7" FontWeight="Bold" FontSize="13" Background="#1D1226" Padding="10"
                      Expanded="ExpanderAvanzate_Expanded" Collapsed="ExpanderAvanzate_Collapsed">
                <StackPanel Margin="0,10,0,0">

                    <!-- 1. Funzioni di emergenza controllo set -->
                    <GroupBox Header="Funzioni di emergenza controllo set" Foreground="#A855F7" FontWeight="Bold" FontSize="12" Padding="10" Margin="0,0,0,10">
                        <UniformGrid Columns="3">
                            <Button Content="Annulla Set" Click="BtnAnnullaSet_Click" Height="32" Background="#444" Foreground="White" FontSize="13" Margin="0,0,4,0"/>
                            <Button Content="Reset Punti" Click="BtnResetPunti_Click" Height="32" Background="#444" Foreground="White" FontSize="13" Margin="2,0,2,0"/>
                            <Button Content="Reset Set" Click="BtnResetSet_Click" Height="32" Background="#662222" Foreground="White" FontSize="13" Margin="4,0,0,0"/>
                        </UniformGrid>
                    </GroupBox>

                    <!-- Riquadro SETUP -->
                    <GroupBox Header="SETUP" Foreground="#A855F7" FontWeight="Bold" FontSize="12" Padding="10" Margin="0,0,0,0">
                        <UniformGrid Columns="4">
                            <Button Content="Opzioni" Click="BtnOpzioni_Click" Height="32" Background="#2A2A2A" Foreground="#AAA" FontSize="13" Margin="0,0,4,0"/>
                            <Button x:Name="BtnApriGestione" Content="Gestione Squadre, Rose giocatori" Click="BtnGestioneSquadre_Click" Height="32" Background="#4A2E6B" Foreground="White" FontSize="11" Margin="2,0,2,0"/>
                            <Button Content="File" Click="BtnFile_Click" Height="32" Background="#2A2A2A" Foreground="#AAA" FontSize="13" Margin="4,0,0,0"/>
                            <Button Content="Info partita" Click="BtnInfoPartita_Click" Height="32" Background="#2A2A2A" Foreground="#AAA" FontSize="12" Margin="4,0,0,0"/>
                        </UniformGrid>
                    </GroupBox>

                </StackPanel>
            </Expander>

        </StackPanel>

        <!-- Stato inferiore -->
        <TextBlock Grid.Row="2" Text="Tabellone Pallavolo - Connesso" Foreground="#666" FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0"/>
    </Grid>
</Window>