<Window x:Class="TabelloneWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tabellone Pallavolo - Serie A" Height="800" Width="1200"
        Background="#120A1A" WindowStartupLocation="CenterScreen"
        Name="FinestraPrincipale">

    <Viewbox Stretch="Fill">
        <Grid x:Name="GridFill" Height="630" Width="1000" Background="#120A1A" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="8"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. INTESTAZIONE BASE (Solo Loghi e Nomi Squadre) -->
            <Grid Grid.Row="0" Margin="0,0,0,5" Grid.RowSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- Squadra 1 (Sinistra) -->
                <Border x:Name="BorderSq1" BorderBrush="Transparent" BorderThickness="2" CornerRadius="4" Padding="0" ClipToBounds="True" Margin="0,0,10,0">
                    <Grid x:Name="GridNomeSquadra1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" Width="55" Height="55" CornerRadius="4" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Image x:Name="ImgLogoSquadra1" Stretch="Uniform" Margin="-1,0,1,0"/>
                        </Border>

                        <TextBlock Grid.Column="1" x:Name="TxtSquadra1" Text="BAMPI LONATO" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>

                <!-- Squadra 2 (Destra) -->
                <Border x:Name="BorderSq2" Grid.Column="2" BorderBrush="Transparent" BorderThickness="2" CornerRadius="4" Padding="0" ClipToBounds="True" HorizontalAlignment="Right">
                    <Grid x:Name="GridNomeSquadra2" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" x:Name="TxtSquadra2" Text="SAUGELLA MONZA" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" TextAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>

                        <Border Grid.Column="1" Background="White" Width="55" Height="55" CornerRadius="4" VerticalAlignment="Center">
                            <Image x:Name="ImgLogoSquadra2" Stretch="Uniform" Margin="4"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 2. CORPO CENTRALE (Solo Liste Giocatori e Staff) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <!-- SQUADRA 1 - Giocatori -->
                <Border x:Name="BorderGiocatori1" Grid.Column="0" BorderBrush="Transparent" BorderThickness="2" CornerRadius="4">
                    <Grid x:Name="GridSquadra1" Background="#1D1226" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ListBox x:Name="ListRosa1" Grid.Row="0" Margin="4" Background="Transparent" Foreground="White" BorderBrush="Transparent" FontSize="16" HorizontalContentAlignment="Stretch" IsHitTestVisible="False">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,-1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Numero}" Foreground="{Binding ForegroundColor}" FontWeight="Bold" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" Text="{Binding NomeFormattatoTabellone}" Foreground="{Binding ForegroundColor}" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ItemsControl x:Name="ItemsStaff1" Grid.Row="1" Margin="6,10,6,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Numero}" Foreground="{Binding ForegroundColor}" FontWeight="Bold" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" Text="{Binding NomeFormattatoTabellone}" Foreground="{Binding ForegroundColor}" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- SQUADRA 2 - Giocatori -->
                <Border x:Name="BorderGiocatori2" Grid.Column="2" BorderBrush="Transparent" BorderThickness="2" CornerRadius="4">
                    <Grid x:Name="GridSquadra2" Background="#1D1226" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ListBox x:Name="ListRosa2" Grid.Row="0" Margin="4" Background="Transparent" Foreground="White" BorderBrush="Transparent" FontSize="16" HorizontalContentAlignment="Stretch" IsHitTestVisible="False">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#99FFFF00"/>
                                            <Setter Property="BorderBrush" Value="#CCFFFF00"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,-1">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#FFFF00"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding NomeFormattatoTabellone}" Foreground="{Binding ForegroundColor}" FontWeight="SemiBold" HorizontalAlignment="Right" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Numero}" Foreground="{Binding ForegroundColor}" FontWeight="Bold" HorizontalAlignment="Right" TextAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ItemsControl x:Name="ItemsStaff2" Grid.Row="1" Margin="6,10,6,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="65"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding NomeFormattatoTabellone}" Foreground="{Binding ForegroundColor}" FontWeight="SemiBold" HorizontalAlignment="Right" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Numero}" Foreground="{Binding ForegroundColor}" FontWeight="Bold" HorizontalAlignment="Right" TextAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. OVERLAY INDIPENDENTE PER PUNTI E SET -->
            <Grid Grid.Row="0" Grid.RowSpan="3" IsHitTestVisible="False" Panel.ZIndex="5">
                <!-- Set nell'Intestazione (Centro Alto) -->
                <Border x:Name="BorderSet" BorderBrush="Transparent" BorderThickness="2" CornerRadius="4" Padding="5" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0">
                    <StackPanel x:Name="GridSet" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtSetS1" Text="0" FontWeight="Bold" Foreground="#FF007ACC" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtSeparatoreSet" Text=" - " FontWeight="Bold" Foreground="#FF007ACC" VerticalAlignment="Center" Margin="5,0"/>
                        <TextBlock x:Name="TxtSetS2" Text="0" FontWeight="Bold" Foreground="#FF007ACC" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Blocco Centrale Punti e Storico -->
                <StackPanel x:Name="GridCentro" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,75,0,0">
                    <!-- Scritta Set Corrente Indipendente -->
                    <TextBlock x:Name="TxtSetCorrente" Text="SET 1" HorizontalAlignment="Center" Margin="0,0,0,5"/>

                    <!-- Bordo Punti (Flessibile per doppia cifra) -->
                    <Border x:Name="BorderPunti" BorderBrush="Transparent" BorderThickness="2" CornerRadius="6" Padding="5">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtPunti1" Text="0" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" TextAlignment="Right" VerticalAlignment="Center" Margin="5,0"/>
                            <TextBlock x:Name="TxtSeparatorePunti" Text="-" FontWeight="Bold" Foreground="White" TextAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                            <TextBlock x:Name="TxtPunti2" Text="0" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" TextAlignment="Left" VerticalAlignment="Center" Margin="5,0"/>
                        </StackPanel>
                    </Border>

                    <!-- (Scritta PUNTI eliminata) -->

                    <!-- Bordo Storico Set (Flessibile e Centrato) -->
                    <Border x:Name="BorderStorico" BorderBrush="Transparent" BorderThickness="2" CornerRadius="5" Background="#1D1226" Padding="15,10" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="STORICO SET" FontSize="11" Foreground="#888" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                            <TextBlock x:Name="TxtStoricoSet" Text="Set 1: 0 - 0" FontSize="13" Foreground="#DDD" HorizontalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

                <!-- Presentazione partita: intestazione in alto e sponsor nella metà bassa -->
                <Grid x:Name="GridPresentazionePartita" Grid.Row="0" Grid.RowSpan="10" Grid.Column="0" Grid.ColumnSpan="10" Visibility="Collapsed" Background="#120A1A" Panel.ZIndex="100">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.05*"/>
                        <RowDefinition Height="0.95*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="28,24,28,12" Background="#1D1226" BorderBrush="#4A2E6B" BorderThickness="2" CornerRadius="10" Padding="24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image x:Name="ImgLogoPresentazionePartita1" Width="150" Height="150" Stretch="Uniform" Margin="0,0,0,10"/>
                                <TextBlock x:Name="TxtNomePresentazionePartita1" Foreground="White" FontSize="30" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="INIZIO PARTITA" Foreground="#A855F7" FontSize="18" FontWeight="Bold" TextAlignment="Center"/>
                                <TextBlock x:Name="TxtOraPresentazionePartita" Foreground="White" FontSize="44" FontWeight="Bold" TextAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image x:Name="ImgLogoPresentazionePartita2" Width="150" Height="150" Stretch="Uniform" Margin="0,0,0,10"/>
                                <TextBlock x:Name="TxtNomePresentazionePartita2" Foreground="White" FontSize="30" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="BorderSponsorPresentazionePartita" Grid.Row="1" Margin="28,12,28,24" Background="#0F0A14" BorderBrush="#4A2E6B" BorderThickness="2" CornerRadius="10" Padding="18" ClipToBounds="True">
                        <Grid ClipToBounds="True">
                            <Image x:Name="ImgSponsorPresentazionePartitaA" Width="520" Height="300" Opacity="0" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Image x:Name="ImgSponsorPresentazionePartitaB" Width="520" Height="300" Opacity="0" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

            <!-- 4. OVERLAY SPONSOR -->
            <Grid x:Name="GridSponsor" Grid.Row="0" Grid.RowSpan="3" Background="#120A1A" Visibility="Collapsed" Panel.ZIndex="10">
                <Image x:Name="ImgSponsor" Opacity="0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"/>
            </Grid>

            <!-- 5 Pannello Presentazione a Tutto Schermo -->
            <Grid x:Name="GridPresentazione" Grid.Row="0" Grid.RowSpan="10" Grid.Column="0" Grid.ColumnSpan="10" Visibility="Collapsed" Background="#120A1A" Panel.ZIndex="99">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <!-- Colonna 0: Sinistra -->
                    <ColumnDefinition Width="*"/>
                    <!-- Colonna 1: Centro (Foto e Nome) -->
                    <ColumnDefinition Width="300"/>
                    <!-- Colonna 2: Destra -->
                </Grid.ColumnDefinitions>

                <!-- COLONNA 0 (Sinistra): Lista Rosa Squadra 1 + Staff (o Logo Squadra 2) -->
                <Grid x:Name="GridPresentazioneSinistra" Grid.Column="0" Margin="20,20,20,20">
                    <!-- StackPanel per la Rosa e lo Staff (rimane in alto quando visibile) -->
                    <Grid VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Lista Rosa Squadra 1 -->
                        <ListBox x:Name="ListPresentazioneRosa1" Grid.Row="0" Background="Transparent" BorderBrush="Transparent" Foreground="White" FontSize="16" HorizontalContentAlignment="Stretch" IsHitTestVisible="False">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,-1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Numero}" Foreground="{Binding ForegroundColor}" FontWeight="Bold" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" Text="{Binding NomeFormattatoTabellone}" Foreground="{Binding ForegroundColor}" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Lista Staff Squadra 1 -->
                        <ItemsControl x:Name="ItemsStaffPres1" Grid.Row="1" Margin="6,16,6,6" Background="Transparent">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Numero}" Foreground="Black" FontWeight="Bold" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" Text="{Binding NomeFormattatoTabellone}" Foreground="Black" FontWeight="Bold" HorizontalAlignment="Left"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- Logo Squadra 2 (Centrato perfettamente al centro della colonna) -->
                    <Image x:Name="ImgLogoPresSquadra2" Stretch="Uniform" Width="200" Height="200" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,30,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtNumeroLogoPresSquadra2" Foreground="Black" FontSize="144" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="260" Margin="0,0,0,30" Visibility="Collapsed"/>
                </Grid>

                <!-- Area Centrale: nome squadra, foto e nome giocatore -->
                <Grid Grid.Column="1" Margin="10,10,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TxtNomeSquadraPresentazione" Grid.Row="0" Text="NOME SQUADRA" Foreground="White" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="390" Margin="0,0,0,10"/>

                    <Border x:Name="BorderFotoPresentazione" Grid.Row="1" BorderBrush="#444" BorderThickness="2" CornerRadius="8" Background="#1D1226" Padding="16" Margin="0,0,0,10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Image x:Name="ImgPresentazione" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock x:Name="TxtPresentazione" Grid.Row="2" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,4"/>
                </Grid>

                <!-- COLONNA 2 (Destra): Lista Rosa Squadra 2 + Staff (o Logo Squadra 1) -->
                <Grid x:Name="GridPresentazioneDestra" Grid.Column="2" Margin="20,20,20,20">
                    <!-- StackPanel per la Rosa e lo Staff (rimane in alto quando visibile) -->
                    <Grid VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Lista Rosa Squadra 2 -->
                        <ListBox x:Name="ListPresentazioneRosa2" Grid.Row="0" Background="Transparent" BorderBrush="Transparent" Foreground="White" FontSize="16" HorizontalContentAlignment="Stretch" Visibility="Collapsed" IsHitTestVisible="False">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,-1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding NomeFormattatoTabellone}" Foreground="{Binding ForegroundColor}" FontWeight="SemiBold" HorizontalAlignment="Right" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Numero}" Foreground="{Binding ForegroundColor}" FontWeight="Bold" HorizontalAlignment="Right" TextAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Lista Staff Squadra 2 -->
                        <ItemsControl x:Name="ItemsStaffPres2" Grid.Row="1" Margin="6,16,6,6" Background="Transparent">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding NomeFormattatoTabellone}" Foreground="Black" FontWeight="Bold" HorizontalAlignment="Right" TextAlignment="Right"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Numero}" Foreground="Black" FontWeight="Bold" HorizontalAlignment="Right" TextAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- Logo Squadra 1 (Centrato perfettamente al centro della colonna) -->
                    <Image x:Name="ImgLogoPresSquadra1" Stretch="Uniform" Width="200" Height="200" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,30,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtNumeroLogoPresSquadra1" Foreground="Black" FontSize="144" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="260" Margin="0,0,0,30" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Grid>
    </Viewbox>
</Window>