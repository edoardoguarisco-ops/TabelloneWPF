<Window x:Class="TabelloneWPF.FinestraOpzioni"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Opzioni Parametri Partita" Height="650" Width="480"
        Background="#E0E0E0" WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TabControl con le due sezioni (Tab) -->
        <TabControl Grid.Row="0" Margin="0,0,0,15">
            
            <!-- TAB 1: OPZIONI GENERALI -->
            <TabItem Header="Generale">
                <Border Background="#F5F5F5" BorderBrush="#CCC" BorderThickness="1" CornerRadius="0,0,4,4" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Impostazioni Generali Interfaccia:" Foreground="#333" FontWeight="Bold" FontSize="13" Margin="0,0,0,15"/>
                        <CheckBox x:Name="ChkAnimazioni" Content="Abilita Pulsanti Animazioni" 
                      Checked="ChkAnimazioni_Checked" Unchecked="ChkAnimazioni_Unchecked" 
                      FontSize="12" Foreground="Black" Margin="0,5"/>

                        <Separator Margin="0,15"/>

                        <!-- Sezione Percorso Foto / Risorse Note -->
                        <TextBlock Text="Percorso di salvataggio foto e configurazioni (Cartella lastconfig):" Foreground="#333" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtPercorsoRisorse" IsReadOnly="True" Background="#E8E8E8" Foreground="Black" Padding="5" Height="28" VerticalContentAlignment="Center" FontSize="11"/>
                        
                        <!-- Percorso Immagini DEF -->
                        <TextBlock Text="Percorso Immagini Predefinite (data/DEF):" Foreground="#333" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtPercorsoDef" IsReadOnly="True" Background="#E8E8E8" Foreground="Black" Padding="5" Height="26" VerticalContentAlignment="Center" FontSize="11" Margin="0,0,0,10"/>

                        <!-- Percorso Sponsor -->
                        <TextBlock Text="Percorso Sponsor (data/sponsor):" Foreground="#333" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtPercorsoSponsor" IsReadOnly="True" Background="#E8E8E8" Foreground="Black" Padding="5" Height="26" VerticalContentAlignment="Center" FontSize="11"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- TAB 2: COLORI TABELLONE -->
            <TabItem Header="Colori Tabellone">
                <Border Background="#F5F5F5" BorderBrush="#CCC" BorderThickness="1" CornerRadius="0,0,4,4" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Lista dei colori con ScrollViewer -->
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Personalizzazione Colori Proiettore / Tabellone:" Foreground="#333" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>

                                <!-- 1. Sfondo Generale -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Colore Sfondo Generale:" Foreground="Black" VerticalAlignment="Center" FontSize="12"/>
                                    <Button Grid.Column="1" Click="BtnCambiaColore_Click" Tag="SfondoGenerale" Height="24" Padding="1">
                                        <Rectangle x:Name="RectSfondoGenerale" Width="50" Height="16" Stroke="Gray" StrokeThickness="1"/>
                                    </Button>
                                </Grid>

                                <!-- 2. Sfondo Squadre (Giocatori) -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Colore Sfondo Squadre (Giocatori):" Foreground="Black" VerticalAlignment="Center" FontSize="12"/>
                                    <Button Grid.Column="1" Click="BtnCambiaColore_Click" Tag="SfondoSquadre" Height="24" Padding="1">
                                        <Rectangle x:Name="RectSfondoSquadre" Width="50" Height="16" Stroke="Gray" StrokeThickness="1"/>
                                    </Button>
                                </Grid>

                                <!-- 3. Sfondo Nome Squadra 1 -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Colore Sfondo Nome Squadra 1:" Foreground="Black" VerticalAlignment="Center" FontSize="12"/>
                                    <Button Grid.Column="1" Click="BtnCambiaColore_Click" Tag="SfondoNomeSquadra1" Height="24" Padding="1">
                                        <Rectangle x:Name="RectSfondoNomeSquadra1" Width="50" Height="16" Stroke="Gray" StrokeThickness="1"/>
                                    </Button>
                                </Grid>

                                <!-- 4. Sfondo Nome Squadra 2 -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Colore Sfondo Nome Squadra 2:" Foreground="Black" VerticalAlignment="Center" FontSize="12"/>
                                    <Button Grid.Column="1" Click="BtnCambiaColore_Click" Tag="SfondoNomeSquadra2" Height="24" Padding="1">
                                        <Rectangle x:Name="RectSfondoNomeSquadra2" Width="50" Height="16" Stroke="Gray" StrokeThickness="1"/>
                                    </Button>
                                </Grid>

                                <!-- 5. Colore carattere punti -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Colore carattere punti:" Foreground="Black" VerticalAlignment="Center" FontSize="12"/>
                                    <CheckBox x:Name="ChkBordoPunti" Content="Bordo" IsChecked="True" Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="Black" Checked="ChkBordo_Changed" Unchecked="ChkBordo_Changed"/>
                                    <Button Grid.Column="2" Click="BtnCambiaColore_Click" Tag="ColoreCaratterePunti" Height="24" Padding="1">
                                        <Rectangle x:Name="RectColoreCaratterePunti" Width="50" Height="16" Stroke="Gray" StrokeThickness="1"/>
                                    </Button>
                                </Grid>

                                <!-- 6. Colori carattere set -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Colori carattere set:" Foreground="Black" VerticalAlignment="Center" FontSize="12"/>
                                    <CheckBox x:Name="ChkBordoSet" Content="Bordo" IsChecked="True" Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="Black" Checked="ChkBordo_Changed" Unchecked="ChkBordo_Changed"/>
                                    <Button Grid.Column="2" Click="BtnCambiaColore_Click" Tag="ColoriCarattereSet" Height="24" Padding="1">
                                        <Rectangle x:Name="RectColoriCarattereSet" Width="50" Height="16" Stroke="Gray" StrokeThickness="1"/>
                                    </Button>
                                </Grid>

                                <!-- 7. Colore carattere storico -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Colore carattere storico:" Foreground="Black" VerticalAlignment="Center" FontSize="12"/>
                                    <CheckBox x:Name="ChkBordoStorico" Content="Bordo" IsChecked="True" Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="Black" Checked="ChkBordo_Changed" Unchecked="ChkBordo_Changed"/>
                                    <Button Grid.Column="2" Click="BtnCambiaColore_Click" Tag="ColoreCarattereStorico" Height="24" Padding="1">
                                        <Rectangle x:Name="RectColoreCarattereStorico" Width="50" Height="16" Stroke="Gray" StrokeThickness="1"/>
                                    </Button>
                                </Grid>

                                <!-- 8. Colore carattere squadra 1 -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Colore carattere squadra 1:" Foreground="Black" VerticalAlignment="Center" FontSize="12"/>
                                    <CheckBox x:Name="ChkBordoSq1" Content="Bordo" IsChecked="True" Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="Black" Checked="ChkBordo_Changed" Unchecked="ChkBordo_Changed"/>
                                    <Button Grid.Column="2" Click="BtnCambiaColore_Click" Tag="ColoreCarattereSquadra1" Height="24" Padding="1">
                                        <Rectangle x:Name="RectColoreCarattereSquadra1" Width="50" Height="16" Stroke="Gray" StrokeThickness="1"/>
                                    </Button>
                                </Grid>

                                <!-- 9. Colore carattere squadra 2 -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Colore carattere squadra 2:" Foreground="Black" VerticalAlignment="Center" FontSize="12"/>
                                    <CheckBox x:Name="ChkBordoSq2" Content="Bordo" IsChecked="True" Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="Black" Checked="ChkBordo_Changed" Unchecked="ChkBordo_Changed"/>
                                    <Button Grid.Column="2" Click="BtnCambiaColore_Click" Tag="ColoreCarattereSquadra2" Height="24" Padding="1">
                                        <Rectangle x:Name="RectColoreCarattereSquadra2" Width="50" Height="16" Stroke="Gray" StrokeThickness="1"/>
                                    </Button>
                                </Grid>

                                <!-- 10. Colore giocatori -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Colore giocatori:" Foreground="Black" VerticalAlignment="Center" FontSize="12"/>
                                    <CheckBox x:Name="ChkBordoGiocatori" Content="Bordo" IsChecked="True" Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="Black" Checked="ChkBordo_Changed" Unchecked="ChkBordo_Changed"/>
                                    <Button Grid.Column="2" Click="BtnCambiaColore_Click" Tag="ColoreGiocatori" Height="24" Padding="1">
                                        <Rectangle x:Name="RectColoreGiocatori" Width="50" Height="16" Stroke="Gray" StrokeThickness="1"/>
                                    </Button>
                                </Grid>

                                <!-- 11. Colore liberi -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Colore liberi:" Foreground="Black" VerticalAlignment="Center" FontSize="12"/>
                                    <Button Grid.Column="1" Click="BtnCambiaColore_Click" Tag="ColoreLiberi" Height="24" Padding="1">
                                        <Rectangle x:Name="RectColoreLiberi" Width="50" Height="16" Stroke="Gray" StrokeThickness="1"/>
                                    </Button>
                                </Grid>

                                <!-- 12. Colore capitano -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Colore capitano:" Foreground="Black" VerticalAlignment="Center" FontSize="12"/>
                                    <Button Grid.Column="1" Click="BtnCambiaColore_Click" Tag="ColoreCapitano" Height="24" Padding="1">
                                        <Rectangle x:Name="RectColoreCapitano" Width="50" Height="16" Stroke="Gray" StrokeThickness="1"/>
                                    </Button>
                                </Grid>

                                <!-- 13. Colore staff -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Colore staff:" Foreground="Black" VerticalAlignment="Center" FontSize="12"/>
                                    <Button Grid.Column="1" Click="BtnCambiaColore_Click" Tag="ColoreStaff" Height="24" Padding="1">
                                        <Rectangle x:Name="RectColoreStaff" Width="50" Height="16" Stroke="Gray" StrokeThickness="1"/>
                                    </Button>
                                </Grid>
                                
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Pulsante Carica Default e Salva -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Carica Default" Click="BtnCaricaDefault_Click" Height="30" Width="120" Background="#666" Foreground="White" FontWeight="Bold" FontSize="12" Margin="0,0,10,0"/>
                            <Button Content="Salva" Click="BtnSalvaColori_Click" Height="30" Width="120" Background="#007ACC" Foreground="White" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 3: DIMENSIONE / POSIZIONE -->
            <TabItem Header="Dimensione / Posizione">
                <Border Background="#F5F5F5" BorderBrush="#CCC" BorderThickness="1" CornerRadius="0,0,4,4" Padding="15">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Personalizzazione Dimensioni Font e Layout:" Foreground="#333" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>

                            <!-- 1. Dimensione Giocatori -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Dimensione Carattere Giocatori:" Foreground="Black" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox x:Name="TxtDimGiocatori" Grid.Column="1" Text="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="24" TextChanged="Dimensione_Changed"/>
                            </Grid>

                            <!-- 2. Dimensione Staff -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Dimensione Carattere Staff:" Foreground="Black" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox x:Name="TxtDimStaff" Grid.Column="1" Text="15" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="24" TextChanged="Dimensione_Changed"/>
                            </Grid>

                            <!-- 3. Dimensione Nomi Squadre -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Dimensione Nomi Squadre:" Foreground="Black" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox x:Name="TxtDimNomiSquadre" Grid.Column="1" Text="22" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="24" TextChanged="Dimensione_Changed"/>
                            </Grid>

                            <!-- 4. Dimensione Punti -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Dimensione Punti (Tabellone):" Foreground="Black" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox x:Name="TxtDimPunti" Grid.Column="1" Text="80" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="24" TextChanged="Dimensione_Changed"/>
                            </Grid>

                            <!-- Dimensione Set Corrente -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Dimensione Scritta Set Corrente:" Foreground="Black" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox x:Name="TxtDimSetCorrente" Grid.Column="1" Text="18" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="24" TextChanged="Dimensione_Changed"/>
                            </Grid>
                            
                            <!-- 5. Dimensione Set -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Dimensione Set:" Foreground="Black" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox x:Name="TxtDimSet" Grid.Column="1" Text="28" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="24" TextChanged="Dimensione_Changed"/>
                            </Grid>

                            <!-- 6. Dimensione Storico -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Dimensione Storico Set:" Foreground="Black" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox x:Name="TxtDimStorico" Grid.Column="1" Text="13" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="24" TextChanged="Dimensione_Changed"/>
                            </Grid>

                            <Separator Margin="0,10"/>
                            <TextBlock Text="Posizione Verticale (Offset in Pixel):" Foreground="#333" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>

                            <!-- Posizione Verticale Punti -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Spostamento Verticale Punti:" Foreground="Black" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox x:Name="TxtPosYPunti" Grid.Column="1" Text="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="24" TextChanged="Dimensione_Changed"/>
                            </Grid>

                            <!-- Posizione Verticale Set -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Spostamento Verticale Set:" Foreground="Black" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox x:Name="TxtPosYSet" Grid.Column="1" Text="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="24" TextChanged="Dimensione_Changed"/>
                            </Grid>

                            <!-- Posizione Verticale Set Corrente -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Spostamento Verticale Set Corrente:" Foreground="Black" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox x:Name="TxtPosYSetCorrente" Grid.Column="1" Text="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="24" TextChanged="Dimensione_Changed"/>
                            </Grid>
                            <!-- Posizione Verticale Storico -->
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Spostamento Verticale Storico:" Foreground="Black" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox x:Name="TxtPosYStorico" Grid.Column="1" Text="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="24" TextChanged="Dimensione_Changed"/>
                            </Grid>

                            <!-- Pulsanti Default e Salva Dimensioni -->
                            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                <Button Content="DEF" Click="BtnCaricaDefaultDimensioni_Click" Height="30" Width="90" Background="#666" Foreground="White" FontWeight="Bold" FontSize="12" Margin="0,0,10,0"/>
                                <Button Content="Salva" Click="BtnSalvaColori_Click" Height="30" Width="120" Background="#007ACC" Foreground="White" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                            
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

        </TabControl>

        <!-- Pulsante Chiudi -->
        <Grid Grid.Row="1">
            <Button Content="Chiudi" Click="BtnChiudi_Click" Height="35" Width="100" Background="#444" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>